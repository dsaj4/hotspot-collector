# Bilibili
BILIBILI_COOKIE=
BILIBILI_FOLLOWING_LIMIT=20

# WeChat RSS through local WeWe RSS
WECHAT_RSS_BASE_URL=http://127.0.0.1:4000
WECHAT_RSS_FEEDS=all
WECHAT_RSS_LIMIT=30

# RSSHub-compatible source routes
RSSHUB_BASE_URL=http://127.0.0.1:1200
GENERIC_RSS_LIMIT=30

# X / Twitter official API collection has been removed.
# Future X support should use explicit RSSHub or browser-session configuration.
BROWSER_EXECUTABLE_PATH=
BILIBILI_CDP_PORT=9223

# Reserved material/content-system integration.
VISION_LIB_ROOT=E:/Project/vision-lib
CONTENT_SYSTEM_API_BASE=http://127.0.0.1:8787
CONTENT_SYSTEM_ACCOUNT=thinking-lab
CONTENT_SYSTEM_FORCE_RESYNC=0

# Material hub LLM analysis
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# IMA material hub sync. Do not commit real values.
MATERIAL_HUB_IMA_KNOWLEDGE_BASE_ID=
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# BiliSum isolated video processing subsystem
BILISUM_BASE_URL=http://127.0.0.1:3838
BILISUM_ACCESS_TOKEN=
BILISUM_TASK_TIMEOUT_MS=600000
BILISUM_POLL_INTERVAL_MS=2000
BILISUM_VISUAL_NOTE_MODE=frame_insert
